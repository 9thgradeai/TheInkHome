{
  "version": 2,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/ai/(.*)", "dest": "/api/ai/index" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/hero.webm", "dest": "/hero.webm" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/fonts/(.*)", "dest": "/fonts/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
