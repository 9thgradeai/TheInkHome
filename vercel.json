{
  "version": 2,
  "functions": {
    "api/stories.ts": { "maxDuration": 60 },
    "api/about.ts": { "maxDuration": 30 },
    "api/ai.ts": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/dist/assets/$1" },
    { "src": "/fonts/(.*)", "dest": "/dist/fonts/$1" },
    { "src": "/manifest.json", "dest": "/dist/manifest.json" },
    { "src": "/sw.js", "dest": "/dist/sw.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
